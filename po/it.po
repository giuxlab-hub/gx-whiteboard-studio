msgstr "Rapporto diagnostico: "

msgid "A backup exists. Recover it as a new unsaved project?"
msgstr "Esiste una copia di sicurezza. Vuoi recuperarla come nuovo progetto non salvato?"

msgid "Backup recovered. Save the project under a NEW filename."
msgstr "Backup recuperato. Salva il progetto con un NUOVO nome file."

msgid "Backup recovery failed"
msgstr "Recupero del backup non riuscito"

msgid "Recording completed with warnings"
msgstr "Registrazione completata con avvisi"

msgid "FFmpeg terminated unexpectedly."
msgstr "FFmpeg è terminato inaspettatamente."

msgid "FFmpeg could not finalize the recording."
msgstr "FFmpeg non ha potuto finalizzare la registrazione."

msgid "MP4 conversion failed; the primary MKV has been preserved."
msgstr "Conversione MP4 non riuscita; il file MKV originale è stato conservato."

msgid "Low available recording disk space."
msgstr "Spazio disponibile per la registrazione insufficiente."

msgid "Could not query output disk space."
msgstr "Impossibile verificare lo spazio del disco di destinazione."

msgid "Recording stopped early to protect the output from a full disk."
msgstr "Registrazione fermata in anticipo per evitare l'esaurimento dello spazio."

msgid "User manual"
msgstr "Manuale utente"

msgid "Manual unavailable"
msgstr "Manuale non disponibile"

msgid "Could not open the local manual."
msgstr "Impossibile aprire il manuale locale."

msgid "The local manual could not be found."
msgstr "Manuale locale non trovato."

msgid "Version 0.1.0 — Drawing, media, scenes and FFmpeg recording."
msgstr "Versione 0.1.0 — Disegno, multimedia, scene e registrazione FFmpeg."

msgid "GX Whiteboard Studio 0.1.0 — project and recording workspace."
msgstr "GX Whiteboard Studio 0.1.0 — progetti e registrazioni."

msgid "Document does not exist."
msgstr "Il documento non esiste."

msgid "Cannot open the project."
msgstr "Impossibile aprire il progetto."

msgid "Unsupported document extension."
msgstr "Estensione del documento non supportata."
